  cierre CierreAcademico? @relation(fields: [id_cierre], references: [id_cierre], onDelete: SetNull)

  usuario Usuario? @relation("UsuarioSituacionHistorial", fields: [id_usuario], references: [id_usuario], onDelete: SetNull)

  @@index([id_matricula, fecha_evento])
  @@index([id_cierre])
  @@index([situacion_nueva])
}

model GradoProgresion {
  id_progresion          Int      @id @default(autoincrement())
  id_colegio             Int
  id_grado_origen        Int
  id_grado_destino       Int?
  tipo_transicion        String   @default("Regular") @db.VarChar(30)
  es_terminal            Boolean  @default(false)
  edad_normativa_destino Int?     @db.TinyInt
  fecha_corte_mes        Int      @default(3) @db.TinyInt
  fecha_corte_dia        Int      @default(31) @db.TinyInt
  estado                 String   @default("Activo") @db.VarChar(20)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  colegio Colegio @relation(fields: [id_colegio], references: [id_colegio], onDelete: Cascade)

  grado_origen Grado @relation("GradoProgresionOrigen", fields: [id_grado_origen], references: [id_grado], onDelete: Cascade)

  grado_destino Grado? @relation("GradoProgresionDestino", fields: [id_grado_destino], references: [id_grado], onDelete: SetNull)

  @@unique([id_colegio, id_grado_origen])
  @@index([id_grado_destino])
  @@index([tipo_transicion])
  @@index([estado])
}

model MovimientoEstudiante {
  id_movimiento       Int      @id @default(autoincrement())
  id_tenant           Int?
  id_estudiante       Int
  id_matricula        Int?
  id_colegio_origen   Int
  id_colegio_destino  Int?
  tipo                String   @db.VarChar(40)
  estado              String   @default("Registrado") @db.VarChar(20)
  fecha_efectiva      DateTime @db.Date
  motivo              String   @db.VarChar(500)
  institucion_destino String?  @db.VarChar(200)
  documento_url       String?  @db.VarChar(500)
  documento_nombre    String?  @db.VarChar(255)
  id_usuario_registro Int?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  tenant     Tenant?    @relation(fields: [id_tenant], references: [id_tenant])
  estudiante Estudiante @relation(fields: [id_estudiante], references: [id_persona])
  matricula  Matricula? @relation(fields: [id_matricula], references: [id_matricula])
  origen     Colegio    @relation("MovimientoColegioOrigen", fields: [id_colegio_origen], references: [id_colegio])
  destino    Colegio?   @relation("MovimientoColegioDestino", fields: [id_colegio_destino], references: [id_colegio])

  registrado_por Usuario? @relation("UsuarioMovimientoEstudiante", fields: [id_usuario_registro], references: [id_usuario], onDelete: SetNull)

  @@index([id_estudiante, fecha_efectiva])
  @@index([id_matricula])
  @@index([id_colegio_origen])
  @@index([id_colegio_destino])
  @@index([tipo, estado])
}

// ======================================================
// RECUPERACIÓN PEDAGÓGICA
// ======================================================

model ProcesoRecuperacion {
  id_proceso               Int       @id @default(autoincrement())
  id_tenant                Int?
  id_colegio               Int
  id_anio                  Int
  tipo                     String    @default("Recuperación pedagógica") @db.VarChar(40)
  estado                   String    @default("Borrador") @db.VarChar(20)
  fecha_inicio             DateTime  @db.Date
  fecha_fin_ordinaria      DateTime  @db.Date
  permite_extraordinario   Boolean   @default(false)
  fecha_fin_extraordinaria DateTime? @db.Date
  motivo_extraordinario    String?   @db.VarChar(500)
  fecha_apertura           DateTime?
  fecha_cierre             DateTime?
  id_usuario_apertura      Int?
  id_usuario_cierre        Int?
  observacion              String?   @db.VarChar(500)
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  tenant  Tenant?     @relation(fields: [id_tenant], references: [id_tenant])
  colegio Colegio     @relation(fields: [id_colegio], references: [id_colegio])
  anio    AnioLectivo @relation(fields: [id_anio], references: [id_anio])

  abierto_por Usuario? @relation("UsuarioProcesoRecuperacionApertura", fields: [id_usuario_apertura], references: [id_usuario], onDelete: SetNull)

  cerrado_por Usuario? @relation("UsuarioProcesoRecuperacionCierre", fields: [id_usuario_cierre], references: [id_usuario], onDelete: SetNull)

  alumnos RecuperacionAlumno[]

  @@unique([id_colegio, id_anio, tipo])
  @@index([estado])
  @@index([fecha_inicio, fecha_fin_ordinaria])
}

model RecuperacionAlumno {
  id_recuperacion_alumno Int       @id @default(autoincrement())
  id_proceso             Int
  id_matricula           Int
  situacion_inicial      String    @default("RR") @db.VarChar(20)
  total_competencias     Int       @default(0)
  competencias_aprobadas Int       @default(0)
  resultado_final        String    @default("PENDIENTE") @db.VarChar(20)
  fecha_resultado        DateTime?
  observacion            String?   @db.VarChar(500)
  id_usuario_resultado   Int?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  proceso   ProcesoRecuperacion @relation(fields: [id_proceso], references: [id_proceso], onDelete: Cascade)
  matricula Matricula           @relation(fields: [id_matricula], references: [id_matricula], onDelete: Cascade)

  resultado_registrado_por Usuario? @relation("UsuarioRecuperacionResultado", fields: [id_usuario_resultado], references: [id_usuario], onDelete: SetNull)

  competencias RecuperacionCompetencia[]

  @@unique([id_proceso, id_matricula])
  @@index([resultado_final])
}

model RecuperacionCompetencia {
  id_recuperacion_competencia Int       @id @default(autoincrement())
  id_recuperacion_alumno      Int
  id_curso                    Int?
  competencia_codigo          String?   @db.VarChar(50)
  competencia_nombre          String    @db.VarChar(200)
  nivel_previo                String?   @db.VarChar(10)
  nivel_recuperacion          String?   @db.VarChar(10)
  resultado                   String    @default("PENDIENTE") @db.VarChar(20)
  fecha_evaluacion            DateTime? @db.Date
  id_docente_evaluador        Int?
  institucion_evaluadora      String?   @db.VarChar(200)
  documento_sustento_url      String?   @db.VarChar(500)
  observacion                 String?   @db.VarChar(500)
  id_usuario_registro         Int?
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  recuperacion_alumno RecuperacionAlumno @relation(fields: [id_recuperacion_alumno], references: [id_recuperacion_alumno], onDelete: Cascade)

  curso Curso? @relation(fields: [id_curso], references: [id_curso], onDelete: SetNull)

  docente_evaluador Docente? @relation("DocenteRecuperacionCompetencia", fields: [id_docente_evaluador], references: [id_persona], onDelete: SetNull)

  registrado_por Usuario? @relation("UsuarioRecuperacionCompetencia", fields: [id_usuario_registro], references: [id_usuario], onDelete: SetNull)

  @@index([id_recuperacion_alumno])
  @@index([id_curso])
  @@index([resultado])
}

