  id_seccion_origen       Int
  id_grado_destino        Int?
  id_seccion_destino      Int?
  situacion_final         String    @db.VarChar(20)
  continuidad             String    @db.VarChar(30)
  accion                  String    @db.VarChar(30)
  estado_resultado        String    @default("PENDIENTE") @db.VarChar(20)
  version_seccion_destino Int?
  snapshot_json           Json?
  error_observacion       String?   @db.VarChar(500)
  fecha_procesado         DateTime?

  lote       LotePromocion @relation(fields: [id_lote], references: [id_lote], onDelete: Cascade)
  estudiante Estudiante    @relation(fields: [id_estudiante], references: [id_persona])

  matricula_origen Matricula @relation("LoteDetalleMatriculaOrigen", fields: [id_matricula_origen], references: [id_matricula])

  matricula_generada Matricula? @relation("LoteDetalleMatriculaGenerada", fields: [id_matricula_generada], references: [id_matricula])

  grado_origen Grado @relation("LoteDetalleGradoOrigen", fields: [id_grado_origen], references: [id_grado])

  grado_destino Grado? @relation("LoteDetalleGradoDestino", fields: [id_grado_destino], references: [id_grado])

  seccion_origen Seccion @relation("LoteDetalleSeccionOrigen", fields: [id_seccion_origen], references: [id_seccion])

  seccion_destino Seccion? @relation("LoteDetalleSeccionDestino", fields: [id_seccion_destino], references: [id_seccion])

  @@unique([id_lote, id_estudiante])
  @@index([id_matricula_origen])
  @@index([id_matricula_generada])
  @@index([id_seccion_destino])
  @@index([estado_resultado])
}

// ======================================================
// CONFIGURACIÓN DE SECCIONES POR AÑO
// ======================================================

model SeccionAnio {
  id_seccion_anio    Int      @id @default(autoincrement())
  id_tenant          Int?
  id_colegio         Int
  id_anio            Int
  id_seccion         Int
  estado             String   @default("Activo") @db.VarChar(20)
  capacidad_override Int?     @db.TinyInt
  version            Int      @default(0)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  tenant  Tenant?     @relation(fields: [id_tenant], references: [id_tenant], onDelete: SetNull)
  colegio Colegio     @relation(fields: [id_colegio], references: [id_colegio], onDelete: Cascade)
  anio    AnioLectivo @relation(fields: [id_anio], references: [id_anio], onDelete: Cascade)
  seccion Seccion     @relation(fields: [id_seccion], references: [id_seccion], onDelete: Cascade)

  @@unique([id_anio, id_seccion])
  @@index([id_colegio, id_anio, estado])
  @@index([id_seccion])
  @@index([version])
}
