  id_tenant                Int?
  id_colegio               Int
  id_anio_origen           Int
  id_anio_destino          Int
  id_seccion_origen        Int
  estado                   String    @default("Borrador") @db.VarChar(20)
  estado_matricula_destino String    @default("Reserva") @db.VarChar(20)
  snapshot_json            Json?
  fecha_vista_previa       DateTime?
  fecha_ejecucion          DateTime?
  fecha_reversion          DateTime?
  id_usuario_creacion      Int?
  id_usuario_ejecucion     Int?
  id_usuario_reversion     Int?
  motivo_reversion         String?   @db.VarChar(500)
  observacion              String?   @db.VarChar(500)
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  tenant  Tenant? @relation(fields: [id_tenant], references: [id_tenant])
  colegio Colegio @relation(fields: [id_colegio], references: [id_colegio])

  anio_origen AnioLectivo @relation("LotePromocionAnioOrigen", fields: [id_anio_origen], references: [id_anio])

  anio_destino AnioLectivo @relation("LotePromocionAnioDestino", fields: [id_anio_destino], references: [id_anio])

  seccion_origen Seccion @relation("LotePromocionSeccionOrigen", fields: [id_seccion_origen], references: [id_seccion])

  creado_por Usuario? @relation("UsuarioLotePromocionCreacion", fields: [id_usuario_creacion], references: [id_usuario], onDelete: SetNull)

  ejecutado_por Usuario? @relation("UsuarioLotePromocionEjecucion", fields: [id_usuario_ejecucion], references: [id_usuario], onDelete: SetNull)

  revertido_por Usuario? @relation("UsuarioLotePromocionReversion", fields: [id_usuario_reversion], references: [id_usuario], onDelete: SetNull)

  detalles LotePromocionDetalle[]

  @@index([id_colegio, id_anio_origen])
  @@index([id_anio_destino])
  @@index([id_seccion_origen])
  @@index([estado])
