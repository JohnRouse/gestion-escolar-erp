  @@index([id_matricula])
  @@index([id_bimestre])
  @@index([id_criterio])
  @@index([id_usuario_registro])
}

// ======================================================
// APP PADRES, TOKENS Y REGISTROS
// ======================================================

model TokenFCM {
  id_token   Int      @id @default(autoincrement())
  id_usuario Int
  token      String   @db.VarChar(500)
  creado_en  DateTime @default(now())

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario])

  @@unique([id_usuario, token])
}

model RegistroNFC {
  id_registro   Int      @id @default(autoincrement())
  id_estudiante Int
  fecha         DateTime @default(now())
  tipo          String   @default("entrada") @db.VarChar(30)

  estudiante Estudiante @relation(fields: [id_estudiante], references: [id_persona])

  @@index([id_estudiante])
  @@index([fecha])
}

// ======================================================
// PLANTILLAS DE EVALUACIÓN
// ======================================================

model PlantillaEvaluacion {
  id_plantilla Int    @id @default(autoincrement())
  id_tenant    Int?
  id_colegio   Int?
  nombre       String @db.VarChar(200)
  id_nivel     Int?
  id_curso     Int?

  tenant  Tenant?  @relation(fields: [id_tenant], references: [id_tenant])
  colegio Colegio? @relation(fields: [id_colegio], references: [id_colegio])
  nivel   Nivel?   @relation(fields: [id_nivel], references: [id_nivel])
  curso   Curso?   @relation(fields: [id_curso], references: [id_curso])

  detalles PlantillaEvaluacionDetalle[]

  @@index([id_tenant])
  @@index([id_colegio])
  @@index([id_nivel])
  @@index([id_curso])
}

model PlantillaEvaluacionDetalle {
  id_detalle        Int    @id @default(autoincrement())
  id_plantilla      Int
  id_tipo_eval      Int
  descripcion       String @db.VarChar(200)
  grupo_evaluacion  String @default("Trabajo en clase") @db.VarChar(50)
  orden             Int    @default(1)

  plantilla PlantillaEvaluacion @relation(fields: [id_plantilla], references: [id_plantilla])
  tipo      TipoEvaluacion      @relation(fields: [id_tipo_eval], references: [id_tipo_eval])

  @@index([id_plantilla])
  @@index([id_tipo_eval])
}

model EstudianteCodigoColegio {
  id_estudiante Int
  id_colegio    Int
  codigo        String   @db.VarChar(30)
  created_at    DateTime @default(now())

  estudiante Estudiante @relation(fields: [id_estudiante], references: [id_persona])
  colegio    Colegio    @relation(fields: [id_colegio], references: [id_colegio])

  @@id([id_estudiante, id_colegio])
  @@unique([id_colegio, codigo])
  @@index([codigo])
}

model DatosCobroColegio {
  id_datos_cobro Int @id @default(autoincrement())
  id_colegio     Int @unique

  nombre_destinatario String  @db.VarChar(160)
  numero_yape         String? @db.VarChar(30)
  numero_plin         String? @db.VarChar(30)

  banco_1  String? @db.VarChar(80)
  cuenta_1 String? @db.VarChar(80)
  cci_1    String? @db.VarChar(80)

  banco_2  String? @db.VarChar(80)
  cuenta_2 String? @db.VarChar(80)
  cci_2    String? @db.VarChar(80)

  qr_yape_url String? @db.VarChar(500)
  qr_plin_url String? @db.VarChar(500)

  instrucciones String? @db.Text
  activo        Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  colegio Colegio @relation(fields: [id_colegio], references: [id_colegio], onDelete: Cascade)

  @@index([activo])
}