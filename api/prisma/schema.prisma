  id_anio              Int
  tipo                 String    @db.VarChar(20)
  estado               String    @default("Borrador") @db.VarChar(20)
  estado_siagie        String    @default("Pendiente de revisión") @db.VarChar(30)
  fecha_inicio         DateTime?
