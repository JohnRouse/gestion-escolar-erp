  url            String

  circular Circular @relation(fields: [id_circular], references: [id_circular])

  @@index([id_circular])
}

model Notificacion {
  id_notif       Int      @id @default(autoincrement())
  id_usuario     Int
  tipo           String   @db.VarChar(50)
  titulo         String
  mensaje        String
