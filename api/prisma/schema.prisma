generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ======================================================
// IDENTIDAD, ACCESO Y SAAS
// ======================================================

model Rol {
  id_rol     Int    @id @default(autoincrement())
  nombre_rol String @unique @db.VarChar(50)

  usuarios Usuario[]
}

model Persona {
  id_persona       Int      @id @default(autoincrement())
  dni              String   @unique @db.VarChar(8)
  nombres          String   @db.VarChar(100)
  apellido_paterno String   @db.VarChar(100)
  apellido_materno String   @db.VarChar(100)
  fecha_nacimiento DateTime
  genero           String?  @db.VarChar(1)

  direccion    String? @db.VarChar(255)
  pais         String? @default("Peru") @db.VarChar(80)
  departamento String? @db.VarChar(80)
  provincia    String? @db.VarChar(80)
  distrito     String? @db.VarChar(80)

  telefono   String?  @db.VarChar(20)
  correo     String?  @db.VarChar(150)
  created_at DateTime @default(now())

  usuarios    Usuario[]
  apoderados  Apoderado[]
  docentes    Docente[]
  estudiantes Estudiante[]
  staff       Staff[]

  @@index([distrito])
  @@index([departamento, distrito])
}

model Usuario {
  id_usuario             Int       @id @default(autoincrement())
  username               String    @unique @db.VarChar(50)
  password_hash          String    @db.VarChar(255)
  id_persona             Int
  id_rol                 Int
  estado                 Boolean   @default(true)
  tema                   String    @default("claro") @db.VarChar(10)
  notificaciones_activas Boolean   @default(true)
  avatar_url             String?   @db.VarChar(255)
  estado_conexion        String    @default("desconectado") @db.VarChar(30)
  ultima_conexion        DateTime?

  persona Persona @relation(fields: [id_persona], references: [id_persona])
  rol     Rol     @relation(fields: [id_rol], references: [id_rol])

  tenants                             UsuarioTenant[]
  colegios                            UsuarioColegio[]
  pagos_cajero                        PagoTransaccion[]
  matriculas_registradas              Matricula[]                   @relation("UsuarioMatriculasRegistradas")
  matriculas_revisadas                Matricula[]                   @relation("UsuarioMatriculasRevisadas")
  circulares                          Circular[]
  notificaciones                      Notificacion[]
  tokensFCM                           TokenFCM[]
  pagos_recibidos_registrados         PagoRecibido[]                @relation("PagoRecibidoRegistro")
  pagos_recibidos_validados           PagoRecibido[]                @relation("PagoRecibidoValidacion")
  pagos_recibidos_historial           PagoRecibidoHistorial[]       @relation("PagoRecibidoHistorialUsuario")
  gestiones_cobranza                  CobranzaGestion[]             @relation("CobranzaGestionUsuario")
  comentarios_bimestrales_registrados ComentarioBimestral[]         @relation("UsuarioComentariosBimestrales")
  calificaciones_tutoria              CalificacionTutoria[]         @relation("UsuarioCalificacionesTutoria")
  historial_estados_institucionales   EstudianteEstadoHistorial[]   @relation("UsuarioEstadoInstitucionalHistorial")
  continuidades_matricula             Matricula[]                   @relation("UsuarioContinuidadMatricula")
  situaciones_matricula               Matricula[]                   @relation("UsuarioSituacionMatricula")
  cierres_academicos_iniciados        CierreAcademico[]             @relation("UsuarioCierreAcademicoInicio")
  cierres_academicos_cerrados         CierreAcademico[]             @relation("UsuarioCierreAcademicoCierre")
  historial_situacion_matriculas      MatriculaSituacionHistorial[] @relation("UsuarioSituacionHistorial")
  procesos_recuperacion_abiertos      ProcesoRecuperacion[]         @relation("UsuarioProcesoRecuperacionApertura")
  procesos_recuperacion_cerrados      ProcesoRecuperacion[]         @relation("UsuarioProcesoRecuperacionCierre")
  resultados_recuperacion             RecuperacionAlumno[]          @relation("UsuarioRecuperacionResultado")
  competencias_recuperacion           RecuperacionCompetencia[]     @relation("UsuarioRecuperacionCompetencia")
  movimientos_estudiante              MovimientoEstudiante[]        @relation("UsuarioMovimientoEstudiante")
  lotes_promocion_creados             LotePromocion[]               @relation("UsuarioLotePromocionCreacion")
  lotes_promocion_ejecutados          LotePromocion[]               @relation("UsuarioLotePromocionEjecucion")
  lotes_promocion_revertidos          LotePromocion[]               @relation("UsuarioLotePromocionReversion")
}

model Tenant {
  id_tenant  Int      @id @default(autoincrement())
  nombre     String   @db.VarChar(150)
  slug       String   @unique @db.VarChar(80)
  ruc        String?  @db.VarChar(20)
  logo_url   String?  @db.VarChar(500)
  estado     String   @default("Activo") @db.VarChar(20)
  plan       String   @default("basic") @db.VarChar(30)
  created_at DateTime @default(now())

  colegios              Colegio[]
  usuarios              UsuarioTenant[]
  anios                 AnioLectivo[]
  aulas                 Aula[]
  secciones             Seccion[]
  matriculas            Matricula[]
  asignaciones          AsignacionDocente[]
  conceptos             ConceptoPago[]
  circulares            Circular[]
  eventos               Evento[]
  staff                 Staff[]
  albumes               Album[]
  plantillas            PlantillaEvaluacion[]
  areas                 AreaCurricular[]
  cursos                Curso[]
  escalas               EscalaCalificacion[]
  tipos_eval            TipoEvaluacion[]
  campanas_matricula    CampanaMatricula[]
  planes_pensiones      PlanPensiones[]
  campanas_descuento    CampanaDescuento[]
  ordenes_pago          OrdenPago[]
  pagos_recibidos       PagoRecibido[]
  criterios_tutoria     CriterioTutoria[]
  cierres_academicos    CierreAcademico[]
  procesos_recuperacion ProcesoRecuperacion[]
  movimientos_alumnos   MovimientoEstudiante[]
  lotes_promocion       LotePromocion[]
  secciones_anio        SeccionAnio[]
}

model Colegio {
  id_colegio             Int      @id @default(autoincrement())
  id_tenant              Int
  nombre                 String   @db.VarChar(150)
  nombre_corto           String?  @db.VarChar(50)
  codigo                 String?  @db.VarChar(30)
  direccion              String?  @db.VarChar(255)
  telefono               String?  @db.VarChar(30)
  logo_url               String?  @db.VarChar(500)
  color_principal        String?  @db.VarChar(20)
  cabecera_libreta_texto String?  @db.VarChar(150)
  estado                 String   @default("Activo") @db.VarChar(20)
  created_at             DateTime @default(now())

  tenant Tenant @relation(fields: [id_tenant], references: [id_tenant])

  usuarios            UsuarioColegio[]
  niveles             ColegioNivel[]
  grados              ColegioGrado[]
  anios               AnioLectivo[]
  aulas               Aula[]
  secciones           Seccion[]
  matriculas          Matricula[]
  asignaciones        AsignacionDocente[]
  conceptos           ConceptoPago[]
  circulares          Circular[]
  eventos             Evento[]
  staff               Staff[]
  albumes             Album[]
  plantillas          PlantillaEvaluacion[]
  areas               AreaCurricular[]
  cursos              Curso[]
  escalas             EscalaCalificacion[]
  tipos_eval          TipoEvaluacion[]
  codigos_estudiantes EstudianteCodigoColegio[]
  historial_estados   EstudianteEstadoHistorial[]
  campanas_matricula  CampanaMatricula[]
  planes_pensiones    PlanPensiones[]
  campanas_descuento  CampanaDescuento[]
  ordenes_pago        OrdenPago[]
  pagos_recibidos     PagoRecibido[]
  datos_cobro         DatosCobroColegio?
  criterios_tutoria   CriterioTutoria[]

  progresiones_grado    GradoProgresion[]
  cierres_academicos    CierreAcademico[]
  procesos_recuperacion ProcesoRecuperacion[]
  movimientos_origen    MovimientoEstudiante[] @relation("MovimientoColegioOrigen")
  movimientos_destino   MovimientoEstudiante[] @relation("MovimientoColegioDestino")
  lotes_promocion       LotePromocion[]

  secciones_anio SeccionAnio[]

  @@unique([id_tenant, codigo])
  @@index([id_tenant])
}

model UsuarioTenant {
  id_usuario Int
  id_tenant  Int
  rol_tenant String @default("Miembro") @db.VarChar(50)
  estado     String @default("Activo") @db.VarChar(20)

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario])
  tenant  Tenant  @relation(fields: [id_tenant], references: [id_tenant])

  @@id([id_usuario, id_tenant])
  @@index([id_tenant])
}

model UsuarioColegio {
  id_usuario   Int
  id_colegio   Int
  rol_colegio  String  @db.VarChar(50)
  es_principal Boolean @default(false)
  estado       String  @default("Activo") @db.VarChar(20)

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario])
  colegio Colegio @relation(fields: [id_colegio], references: [id_colegio])

  @@id([id_usuario, id_colegio])
  @@index([id_colegio])
}

model ColegioNivel {
  id_colegio Int
  id_nivel   Int

  colegio Colegio @relation(fields: [id_colegio], references: [id_colegio])
  nivel   Nivel   @relation(fields: [id_nivel], references: [id_nivel])

  @@id([id_colegio, id_nivel])
}

model ColegioGrado {
  id_colegio Int
  id_grado   Int
  estado     String @default("Activo") @db.VarChar(20)

  colegio Colegio @relation(fields: [id_colegio], references: [id_colegio], onDelete: Cascade)
  grado   Grado   @relation(fields: [id_grado], references: [id_grado], onDelete: Cascade)

  @@id([id_colegio, id_grado])
  @@index([id_grado])
}

// ======================================================
// ESTRUCTURA ACADÉMICA
// ======================================================

model Nivel {
  id_nivel     Int    @id @default(autoincrement())
  nombre_nivel String @db.VarChar(50)

  grados     Grado[]
  colegios   ColegioNivel[]
  circulares CircularDestinatario[]
  plantillas PlantillaEvaluacion[]
}

model Grado {
  id_grado     Int    @id @default(autoincrement())
  nombre_grado String @db.VarChar(50)
  id_nivel     Int

  nivel                      Nivel                  @relation(fields: [id_nivel], references: [id_nivel])
  secciones                  Seccion[]
  colegios                   ColegioGrado[]
  progresiones_origen        GradoProgresion[]      @relation("GradoProgresionOrigen")
  progresiones_destino       GradoProgresion[]      @relation("GradoProgresionDestino")
  detalles_promocion_origen  LotePromocionDetalle[] @relation("LoteDetalleGradoOrigen")
  detalles_promocion_destino LotePromocionDetalle[] @relation("LoteDetalleGradoDestino")
}

model Aula {
  id_aula     Int    @id @default(autoincrement())
  id_tenant   Int?
  id_colegio  Int?
  nombre_aula String @db.VarChar(50)
  capacidad   Int    @db.TinyInt

  tenant  Tenant?  @relation(fields: [id_tenant], references: [id_tenant])
  colegio Colegio? @relation(fields: [id_colegio], references: [id_colegio])

  secciones Seccion[]

  @@index([id_tenant])
  @@index([id_colegio])
}

model Seccion {
  id_seccion Int    @id @default(autoincrement())
  id_tenant  Int?
  id_colegio Int?
  letra      String @db.Char(1)
  id_grado   Int
  id_aula    Int
  version    Int    @default(0)

  tenant  Tenant?  @relation(fields: [id_tenant], references: [id_tenant])
  colegio Colegio? @relation(fields: [id_colegio], references: [id_colegio])
  grado   Grado    @relation(fields: [id_grado], references: [id_grado])
  aula    Aula     @relation(fields: [id_aula], references: [id_aula])

  matriculas   Matricula[]
  asignaciones AsignacionDocente[]
  circulares   CircularDestinatario[]
  horarios     Horario[]
  staff        Staff[]
  albumes      Album[]

  lotes_promocion_origen     LotePromocion[]        @relation("LotePromocionSeccionOrigen")
  detalles_promocion_origen  LotePromocionDetalle[] @relation("LoteDetalleSeccionOrigen")
  detalles_promocion_destino LotePromocionDetalle[] @relation("LoteDetalleSeccionDestino")

  configuraciones_anio SeccionAnio[]

  @@index([id_tenant])
  @@index([id_colegio])
  @@index([id_grado])
  @@index([id_aula])
}

model AreaCurricular {
  id_area     Int    @id @default(autoincrement())
  id_tenant   Int?
  id_colegio  Int?
  nombre_area String @db.VarChar(100)

  tenant  Tenant?  @relation(fields: [id_tenant], references: [id_tenant])
  colegio Colegio? @relation(fields: [id_colegio], references: [id_colegio])

  cursos         Curso[]
  especialidades DocenteEspecialidad[]

  @@index([id_tenant])
  @@index([id_colegio])
}

model Curso {
  id_curso     Int    @id @default(autoincrement())
  id_tenant    Int?
  id_colegio   Int?
  nombre_curso String @db.VarChar(100)
  id_area      Int

  tenant  Tenant?        @relation(fields: [id_tenant], references: [id_tenant])
  colegio Colegio?       @relation(fields: [id_colegio], references: [id_colegio])
  area    AreaCurricular @relation(fields: [id_area], references: [id_area])

  asignaciones AsignacionDocente[]
  horarios     Horario[]
  plantillas   PlantillaEvaluacion[]

  recuperaciones_competencia RecuperacionCompetencia[]

  @@index([id_area])
  @@index([id_tenant])
  @@index([id_colegio])
}

// ======================================================
// TIEMPO ACADÉMICO
// ======================================================

model AnioLectivo {
  id_anio      Int      @id @default(autoincrement())
  id_tenant    Int?
  id_colegio   Int?
  nombre_anio  String   @db.VarChar(50)
  fecha_inicio DateTime @db.Date
  fecha_fin    DateTime @db.Date
  estado       String   @default("Planificación") @db.VarChar(20)

  tenant  Tenant?  @relation(fields: [id_tenant], references: [id_tenant])
  colegio Colegio? @relation(fields: [id_colegio], references: [id_colegio])

  bimestres                      Bimestre[]
  matriculas                     Matricula[]         @relation("MatriculaAnioLectivo")
  matriculas_continuidad_destino Matricula[]         @relation("AnioDestinoContinuidad")
  conceptos                      ConceptoPago[]
  asignaciones                   AsignacionDocente[]
  eventos                        Evento[]
  campanas_matricula             CampanaMatricula[]
  planes_pensiones               PlanPensiones[]
  campanas_descuento             CampanaDescuento[]

  horarios Horario[]

  cierres_academicos      CierreAcademico[]
  procesos_recuperacion   ProcesoRecuperacion[]
  lotes_promocion_origen  LotePromocion[]       @relation("LotePromocionAnioOrigen")
  lotes_promocion_destino LotePromocion[]       @relation("LotePromocionAnioDestino")

  secciones_anio SeccionAnio[]

  @@index([id_tenant])
  @@index([id_colegio])
}

model Bimestre {
  id_bimestre  Int      @id @default(autoincrement())
  numero       Int      @db.TinyInt
  nombre       String?  @db.VarChar(80)
  fecha_inicio DateTime @db.Date
  fecha_fin    DateTime @db.Date
  id_anio      Int

  anio AnioLectivo @relation(fields: [id_anio], references: [id_anio])

  unidades               Unidad[]
  comentariosBimestrales ComentarioBimestral[]
  calificaciones_tutoria CalificacionTutoria[]

  @@index([id_anio])
}

model Unidad {
  id_unidad      Int      @id @default(autoincrement())
  numero         Int      @db.TinyInt
  nombre         String?  @db.VarChar(80)
  fecha_inicio   DateTime @db.Date
  fecha_fin      DateTime @db.Date
  id_bimestre    Int
  estado_abierto Boolean  @default(false)

  bimestre Bimestre @relation(fields: [id_bimestre], references: [id_bimestre])

  evaluaciones    EvaluacionDetalle[]
  registros_notas RegistroNotasUnidad[]

  @@index([id_bimestre])
}

// ======================================================
// ACTORES EDUCATIVOS
// ======================================================

model Apoderado {
  id_persona Int     @id
  ocupacion  String? @db.VarChar(100)

  persona Persona @relation(fields: [id_persona], references: [id_persona])

  estudiantes     ApoderadoEstudiante[]
  pagos           PagoTransaccion[]
  citas           Cita[]
  comentarios     ComentarioFoto[]
  reacciones      ReaccionFoto[]
  ordenes_pago    OrdenPago[]
  pagos_recibidos PagoRecibido[]
}

model Docente {
  id_persona    Int       @id
  fecha_ingreso DateTime? @db.Date

  persona Persona @relation(fields: [id_persona], references: [id_persona])

  especialidades            DocenteEspecialidad[]
  asignaciones              AsignacionDocente[]
  horarios                  Horario[]
  albumes                   Album[]
  comentariosBimestrales    ComentarioBimestral[]
  competencias_recuperacion RecuperacionCompetencia[] @relation("DocenteRecuperacionCompetencia")
}

model Estudiante {
  id_persona        Int     @id
  codigo_estudiante String  @unique @db.VarChar(20)
  avatar_url        String? @db.VarChar(255)

  persona Persona @relation(fields: [id_persona], references: [id_persona])

  apoderados         ApoderadoEstudiante[]
  matriculas         Matricula[]
  registrosNFC       RegistroNFC[]
  codigos_colegio    EstudianteCodigoColegio[]
  historial_estados  EstudianteEstadoHistorial[]
  ordenes_pago       OrdenPago[]
  pagos_recibidos    PagoRecibido[]
  movimientos        MovimientoEstudiante[]
  detalles_promocion LotePromocionDetalle[]
}

model ApoderadoEstudiante {
  id_apoderado  Int
  id_estudiante Int
  parentesco    String @db.VarChar(30)

  apoderado  Apoderado  @relation(fields: [id_apoderado], references: [id_persona])
  estudiante Estudiante @relation(fields: [id_estudiante], references: [id_persona])

  @@id([id_apoderado, id_estudiante])
  @@index([id_estudiante])
}

model DocenteEspecialidad {
  id_docente Int
  id_area    Int

  docente Docente        @relation(fields: [id_docente], references: [id_persona])
  area    AreaCurricular @relation(fields: [id_area], references: [id_area])

  @@id([id_docente, id_area])
}

// ======================================================
// MATRÍCULA
// ======================================================

model Matricula {
  id_matricula               Int       @id @default(autoincrement())
  codigo_matricula           String?   @unique @db.VarChar(40)
  id_tenant                  Int?
  id_colegio                 Int?
  id_estudiante              Int
  id_seccion                 Int
  id_anio                    Int
  fecha_matricula            DateTime  @default(now())
  estado_matricula           String    @default("Pre-matriculado") @db.VarChar(20)
  id_usuario_registro        Int?
  tipo_ingreso               String    @default("Nuevo") @db.VarChar(30)
  colegio_procedencia        String?   @db.VarChar(150)
  codigo_modular_procedencia String?   @db.VarChar(30)
  grado_procedencia          String?   @db.VarChar(80)
  observacion_procedencia    String?   @db.VarChar(500)
  id_matricula_origen        Int?
  id_colegio_origen          Int?
  id_anio_origen             Int?
  tipo_proceso_matricula     String?   @db.VarChar(50)
  estado_revision            String    @default("Por revisar") @db.VarChar(30)
  id_usuario_revision        Int?
  fecha_revision             DateTime?
  observacion_revision       String?   @db.VarChar(500)
  fecha_cierre               DateTime?
  motivo_cierre              String?   @db.VarChar(500)
  id_usuario_cierre          Int?

  continuidad_siguiente_anio String    @default("Pendiente") @db.VarChar(30)
  id_anio_continuidad        Int?
  fecha_continuidad          DateTime?
  motivo_continuidad         String?   @db.VarChar(500)
  id_usuario_continuidad     Int?

  situacion_final             String    @default("PENDIENTE") @db.VarChar(20)
  es_egresado                 Boolean   @default(false)
  fecha_situacion_final       DateTime?
  observacion_situacion_final String?   @db.VarChar(500)
  id_usuario_situacion_final  Int?

  tenant                     Tenant?      @relation(fields: [id_tenant], references: [id_tenant])
  colegio                    Colegio?     @relation(fields: [id_colegio], references: [id_colegio])
  estudiante                 Estudiante   @relation(fields: [id_estudiante], references: [id_persona])
  seccion                    Seccion      @relation(fields: [id_seccion], references: [id_seccion])
  anio                       AnioLectivo  @relation("MatriculaAnioLectivo", fields: [id_anio], references: [id_anio])
  anio_continuidad           AnioLectivo? @relation("AnioDestinoContinuidad", fields: [id_anio_continuidad], references: [id_anio])
  registrado_por             Usuario?     @relation("UsuarioMatriculasRegistradas", fields: [id_usuario_registro], references: [id_usuario])
  revisado_por               Usuario?     @relation("UsuarioMatriculasRevisadas", fields: [id_usuario_revision], references: [id_usuario])
  continuidad_registrada_por Usuario?     @relation("UsuarioContinuidadMatricula", fields: [id_usuario_continuidad], references: [id_usuario])
  situacion_registrada_por   Usuario?     @relation("UsuarioSituacionMatricula", fields: [id_usuario_situacion_final], references: [id_usuario], onDelete: SetNull)

  notas                  NotaAlumno[]
  asistencias            Asistencia[]
  cronogramas            CronogramaPagos[]
  comentariosBimestrales ComentarioBimestral[]
  ordenes_pago           OrdenPago[]
  pagos_recibidos        PagoRecibido[]
  calificaciones_tutoria CalificacionTutoria[]

  historial_situacion    MatriculaSituacionHistorial[]
  recuperaciones         RecuperacionAlumno[]
  movimientos            MovimientoEstudiante[]
  detalles_lote_origen   LotePromocionDetalle[]        @relation("LoteDetalleMatriculaOrigen")
  detalles_lote_generada LotePromocionDetalle[]        @relation("LoteDetalleMatriculaGenerada")

  @@index([id_estudiante, id_anio])
  @@index([id_seccion])
  @@index([id_anio])
  @@index([id_tenant])
  @@index([id_colegio])
  @@index([id_usuario_registro])
  @@index([estado_revision])
  @@index([tipo_ingreso])
  @@index([id_usuario_revision])
  @@index([id_matricula_origen])
  @@index([id_colegio_origen, id_anio_origen])
  @@index([tipo_proceso_matricula])
  @@index([estado_matricula])
  @@index([continuidad_siguiente_anio])
  @@index([id_anio_continuidad])
  @@index([id_usuario_continuidad])
  @@index([situacion_final])
  @@index([id_usuario_situacion_final])
}

// ======================================================
// DOCENTES, EVALUACIONES Y NOTAS
// ======================================================

model AsignacionDocente {
  id_asignacion Int  @id @default(autoincrement())
  id_tenant     Int?
  id_colegio    Int?
  id_docente    Int
  id_curso      Int
  id_seccion    Int
  id_anio       Int

  tenant  Tenant?     @relation(fields: [id_tenant], references: [id_tenant])
  colegio Colegio?    @relation(fields: [id_colegio], references: [id_colegio])
  docente Docente     @relation(fields: [id_docente], references: [id_persona])
  curso   Curso       @relation(fields: [id_curso], references: [id_curso])
  seccion Seccion     @relation(fields: [id_seccion], references: [id_seccion])
  anio    AnioLectivo @relation(fields: [id_anio], references: [id_anio])

  evaluaciones    EvaluacionDetalle[]
  registros_notas RegistroNotasUnidad[]

  @@index([id_docente, id_anio])
  @@index([id_curso])
  @@index([id_seccion])
  @@index([id_tenant])
  @@index([id_colegio])
}

model TipoEvaluacion {
  id_tipo_eval Int    @id @default(autoincrement())
  id_tenant    Int?
  id_colegio   Int?
  nombre_tipo  String @db.VarChar(50)

  tenant  Tenant?  @relation(fields: [id_tenant], references: [id_tenant])
  colegio Colegio? @relation(fields: [id_colegio], references: [id_colegio])

  evaluaciones      EvaluacionDetalle[]
  detallesPlantilla PlantillaEvaluacionDetalle[]

  @@index([id_tenant])
  @@index([id_colegio])
}

model EvaluacionDetalle {
  id_evaluacion_det     Int       @id @default(autoincrement())
  id_asignacion         Int
  id_unidad             Int
  id_tipo_eval          Int
  descripcion_actividad String?   @db.VarChar(100)
  grupo_evaluacion      String?   @db.VarChar(50)
  fecha_evaluacion      DateTime? @db.Date
  orden                 Int       @default(0)

  asignacion AsignacionDocente @relation(fields: [id_asignacion], references: [id_asignacion])
  unidad     Unidad            @relation(fields: [id_unidad], references: [id_unidad])
  tipo       TipoEvaluacion    @relation(fields: [id_tipo_eval], references: [id_tipo_eval])

  notas NotaAlumno[]

  @@index([id_asignacion])
  @@index([id_unidad])
  @@index([id_tipo_eval])
}

model EscalaCalificacion {
  id_escala         Int     @id @default(autoincrement())
  id_tenant         Int?
  id_colegio        Int?
  nombre_escala     String  @db.VarChar(50)
  nota_minima       Decimal @db.Decimal(4, 2)
  nota_maxima       Decimal @db.Decimal(4, 2)
  nota_aprobatoria  Decimal @db.Decimal(4, 2)
  tipo_calificacion String  @default("Numérica") @db.VarChar(20)

  tenant  Tenant?  @relation(fields: [id_tenant], references: [id_tenant])
  colegio Colegio? @relation(fields: [id_colegio], references: [id_colegio])

  @@index([id_tenant])
  @@index([id_colegio])
}

model NotaAlumno {
  id_nota           Int     @id @default(autoincrement())
  id_matricula      Int
  id_evaluacion_det Int
  valor_nota        Decimal @db.Decimal(4, 2)
  comentario        String? @db.Text

  matricula  Matricula         @relation(fields: [id_matricula], references: [id_matricula])
  evaluacion EvaluacionDetalle @relation(fields: [id_evaluacion_det], references: [id_evaluacion_det])

  @@index([id_matricula])
  @@index([id_evaluacion_det])
}

model RegistroNotasUnidad {
  id_registro_notas Int       @id @default(autoincrement())
  id_asignacion     Int
  id_unidad         Int
  cerrado           Boolean   @default(false)
  cerrado_por       Int?
  fecha_cierre      DateTime?
  reabierto_por     Int?
  fecha_reapertura  DateTime?
  motivo_reapertura String?   @db.VarChar(500)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  asignacion AsignacionDocente @relation(fields: [id_asignacion], references: [id_asignacion], onDelete: Cascade)
  unidad     Unidad            @relation(fields: [id_unidad], references: [id_unidad], onDelete: Cascade)

  @@unique([id_asignacion, id_unidad])
  @@index([id_asignacion])
  @@index([id_unidad])
}

// ======================================================
// ASISTENCIA
// ======================================================

model Asistencia {
  id_asistencia                Int       @id @default(autoincrement())
  id_matricula                 Int
  fecha                        DateTime  @db.Date
  estado                       String    @db.VarChar(20)
  justificacion_motivo         String?   @db.VarChar(120)
  justificacion_observacion    String?   @db.VarChar(500)
  justificado_por              Int?
  fecha_justificacion          DateTime?
  justificacion_archivo_url    String?   @db.VarChar(500)
  justificacion_archivo_nombre String?   @db.VarChar(255)
  justificacion_archivo_mime   String?   @db.VarChar(120)
  justificacion_archivo_size   Int?

  matricula Matricula @relation(fields: [id_matricula], references: [id_matricula])

  @@unique([id_matricula, fecha])
  @@index([fecha])
  @@index([estado])
}

// ======================================================
// FINANZAS
// ======================================================

model ConceptoPago {
  id_concepto       Int     @id @default(autoincrement())
  id_tenant         Int?
  id_colegio        Int?
  nombre_concepto   String  @db.VarChar(100)
  monto_base        Decimal @db.Decimal(10, 2)
  id_anio           Int
  es_pension        Boolean @default(true)
  es_extraordinario Boolean @default(false)
  tipo_concepto     String  @default("PENSION") @db.VarChar(30)

  tenant  Tenant?     @relation(fields: [id_tenant], references: [id_tenant])
  colegio Colegio?    @relation(fields: [id_colegio], references: [id_colegio])
  anio    AnioLectivo @relation(fields: [id_anio], references: [id_anio])

  cronogramas           CronogramaPagos[]
  detalles_plan_pension PlanPensionesDetalle[]

  @@index([id_anio])
  @@index([id_tenant])
  @@index([id_colegio])
  @@index([tipo_concepto])
  @@index([id_anio, id_colegio, tipo_concepto])
}

model CampanaMatricula {
  id_campana            Int      @id @default(autoincrement())
  id_tenant             Int?
  id_colegio            Int?
  id_anio               Int
  nombre                String   @db.VarChar(120)
  descripcion           String?  @db.VarChar(500)
  fecha_inicio          DateTime @db.Date
  fecha_fin             DateTime @db.Date
  monto_promocional     Decimal? @db.Decimal(10, 2)
  descuento_monto       Decimal? @db.Decimal(10, 2)
  tipo_ingreso_aplica   String?  @db.VarChar(160)
  solo_alumnos_vigentes Boolean  @default(true)
  estado                String   @default("Activo") @db.VarChar(20)
  created_at            DateTime @default(now())

  tenant  Tenant?     @relation(fields: [id_tenant], references: [id_tenant])
  colegio Colegio?    @relation(fields: [id_colegio], references: [id_colegio])
  anio    AnioLectivo @relation(fields: [id_anio], references: [id_anio])

  cronogramas CronogramaPagos[]

  @@index([id_tenant])
  @@index([id_colegio])
  @@index([id_anio])
  @@index([estado, fecha_inicio, fecha_fin])
}

model PlanPensiones {
  id_plan_pension Int      @id @default(autoincrement())
  id_tenant       Int?
  id_colegio      Int
  id_anio         Int
  nombre          String   @db.VarChar(120)
  monto_mensual   Decimal  @db.Decimal(10, 2)
  mes_inicio      Int      @default(3) @db.TinyInt
  mes_fin         Int      @default(12) @db.TinyInt
  dia_publicacion Int      @default(1) @db.TinyInt
  dia_vencimiento Int      @default(5) @db.TinyInt
  estado          String   @default("Activo") @db.VarChar(20)
  created_at      DateTime @default(now())

  tenant  Tenant?     @relation(fields: [id_tenant], references: [id_tenant])
  colegio Colegio     @relation(fields: [id_colegio], references: [id_colegio])
  anio    AnioLectivo @relation(fields: [id_anio], references: [id_anio])

  detalles PlanPensionesDetalle[]

  @@index([id_tenant])
  @@index([id_colegio])
  @@index([id_anio])
  @@index([estado])
}

model PlanPensionesDetalle {
  id_plan_detalle   Int      @id @default(autoincrement())
  id_plan_pension   Int
  id_concepto       Int
  mes               Int      @db.TinyInt
  nombre_mes        String   @db.VarChar(20)
  fecha_publicacion DateTime @db.Date
  fecha_vencimiento DateTime @db.Date
  monto_base        Decimal  @db.Decimal(10, 2)
  estado            String   @default("Programado") @db.VarChar(20)

  plan     PlanPensiones @relation(fields: [id_plan_pension], references: [id_plan_pension])
  concepto ConceptoPago  @relation(fields: [id_concepto], references: [id_concepto])

  cronogramas CronogramaPagos[]

  @@unique([id_plan_pension, mes])
  @@index([id_plan_pension])
  @@index([id_concepto])
  @@index([mes])
}

model CampanaDescuento {
  id_campana_descuento  Int      @id @default(autoincrement())
  id_tenant             Int?
  id_colegio            Int?
  id_anio               Int?
  nombre                String   @db.VarChar(120)
  descripcion           String?  @db.VarChar(500)
  fecha_inicio          DateTime @db.Date
  fecha_fin             DateTime @db.Date
  tipo_concepto_aplica  String?  @db.VarChar(30)
  tipo_ingreso_aplica   String?  @db.VarChar(160)
  monto_promocional     Decimal? @db.Decimal(10, 2)
  descuento_monto       Decimal? @db.Decimal(10, 2)
  descuento_porcentaje  Decimal? @db.Decimal(5, 2)
  solo_alumnos_vigentes Boolean  @default(false)
  estado                String   @default("Activo") @db.VarChar(20)
  created_at            DateTime @default(now())

  tenant  Tenant?      @relation(fields: [id_tenant], references: [id_tenant])
  colegio Colegio?     @relation(fields: [id_colegio], references: [id_colegio])
  anio    AnioLectivo? @relation(fields: [id_anio], references: [id_anio])

  cronogramas CronogramaPagos[]

  @@index([id_tenant])
  @@index([id_colegio])
  @@index([id_anio])
  @@index([tipo_concepto_aplica])
  @@index([estado, fecha_inicio, fecha_fin])
}

model CronogramaPagos {
  id_cronograma           Int       @id @default(autoincrement())
  id_matricula            Int
  id_concepto             Int
  fecha_vencimiento       DateTime  @db.Date
  estado_pago             String    @default("Pendiente") @db.VarChar(20)
  monto_base_original     Decimal?  @db.Decimal(10, 2)
  descuento_aplicado      Decimal   @default(0) @db.Decimal(10, 2)
  monto_programado        Decimal?  @db.Decimal(10, 2)
  id_campana_matricula    Int?
  id_plan_pension_detalle Int?
  id_campana_descuento    Int?
  estado_publicacion      String    @default("Publicado") @db.VarChar(20)
  fecha_publicacion       DateTime? @db.Date
  fecha_publicado         DateTime?
  visible_apoderado       Boolean   @default(true)
  referencia_pago         String?   @unique @db.VarChar(40)

  matricula            Matricula             @relation(fields: [id_matricula], references: [id_matricula])
  concepto             ConceptoPago          @relation(fields: [id_concepto], references: [id_concepto])
  campana              CampanaMatricula?     @relation(fields: [id_campana_matricula], references: [id_campana])
  plan_pension_detalle PlanPensionesDetalle? @relation(fields: [id_plan_pension_detalle], references: [id_plan_detalle])
  campana_descuento    CampanaDescuento?     @relation(fields: [id_campana_descuento], references: [id_campana_descuento])

  pagos              PagoTransaccion[]
  ordenes_pago       OrdenPago[]
  pagos_recibidos    PagoRecibido[]
  gestiones_cobranza CobranzaGestion[]

  @@unique([id_matricula, id_concepto], name: "uq_cronograma_matricula_concepto")
  @@index([fecha_vencimiento, estado_pago])
  @@index([id_concepto])
  @@index([id_campana_matricula])
  @@index([id_plan_pension_detalle])
  @@index([id_campana_descuento])
  @@index([estado_publicacion, fecha_publicacion, visible_apoderado])
}

model PagoTransaccion {
  id_transaccion    Int      @id @default(autoincrement())
  id_cronograma     Int
  id_apoderado      Int
  id_usuario_cajero Int
  monto_pagado      Decimal  @db.Decimal(10, 2)
  fecha_pago        DateTime @default(now())
  metodo_pago       String?  @db.VarChar(20)
  nro_operacion     String?  @db.VarChar(50)

  cronograma CronogramaPagos @relation(fields: [id_cronograma], references: [id_cronograma])
  apoderado  Apoderado       @relation(fields: [id_apoderado], references: [id_persona])
  cajero     Usuario         @relation(fields: [id_usuario_cajero], references: [id_usuario])

  @@index([id_cronograma])
  @@index([id_apoderado])
  @@index([id_usuario_cajero])
}

model OrdenPago {
  id_orden_pago       Int       @id @default(autoincrement())
  codigo_orden        String    @unique @db.VarChar(40)
  id_tenant           Int?
  id_colegio          Int?
  id_cronograma       Int
  id_matricula        Int
  id_estudiante       Int
  id_apoderado        Int?
  proveedor           String    @default("MANUAL") @db.VarChar(30)
  metodo              String?   @db.VarChar(30)
  monto               Decimal   @db.Decimal(10, 2)
  moneda              String    @default("PEN") @db.VarChar(3)
  estado              String    @default("Creada") @db.VarChar(20)
  checkout_url        String?   @db.VarChar(500)
  qr_url              String?   @db.VarChar(500)
  provider_order_id   String?   @db.VarChar(120)
  provider_payment_id String?   @db.VarChar(120)
  provider_response   Json?
  metadata_json       Json?
  fecha_creacion      DateTime  @default(now())
  fecha_expiracion    DateTime?
  fecha_pago          DateTime?

  tenant     Tenant?         @relation(fields: [id_tenant], references: [id_tenant])
  colegio    Colegio?        @relation(fields: [id_colegio], references: [id_colegio])
  cronograma CronogramaPagos @relation(fields: [id_cronograma], references: [id_cronograma])
  matricula  Matricula       @relation(fields: [id_matricula], references: [id_matricula])
  estudiante Estudiante      @relation(fields: [id_estudiante], references: [id_persona])
  apoderado  Apoderado?      @relation(fields: [id_apoderado], references: [id_persona])

  @@index([id_cronograma])
  @@index([id_matricula])
  @@index([id_estudiante])
  @@index([id_apoderado])
  @@index([estado])
  @@index([provider_order_id])
}

model PagoRecibido {
  id_pago_recibido      Int       @id @default(autoincrement())
  id_tenant             Int?
  id_colegio            Int?
  medio_pago            String    @default("Yape") @db.VarChar(30)
  monto_recibido        Decimal   @db.Decimal(10, 2)
  fecha_pago_reportada  DateTime
  nombre_pagador        String?   @db.VarChar(160)
  telefono_pagador      String?   @db.VarChar(30)
  numero_operacion      String?   @db.VarChar(80)
  referencia_escrita    String?   @db.VarChar(80)
  captura_url           String?   @db.VarChar(500)
  estado                String    @default("Pendiente") @db.VarChar(20)
  id_cronograma         Int?
  id_matricula          Int?
  id_estudiante         Int?
  id_apoderado          Int?
  observacion           String?   @db.VarChar(600)
  id_usuario_registro   Int?
  id_usuario_validacion Int?
  fecha_validacion      DateTime?
  banco_destino         String?   @db.VarChar(80)
  origen_reporte        String?   @default("Interno") @db.VarChar(50)
  created_at            DateTime  @default(now())

  tenant         Tenant?                 @relation(fields: [id_tenant], references: [id_tenant])
  colegio        Colegio?                @relation(fields: [id_colegio], references: [id_colegio])
  cronograma     CronogramaPagos?        @relation(fields: [id_cronograma], references: [id_cronograma])
  matricula      Matricula?              @relation(fields: [id_matricula], references: [id_matricula])
  estudiante     Estudiante?             @relation(fields: [id_estudiante], references: [id_persona])
  apoderado      Apoderado?              @relation(fields: [id_apoderado], references: [id_persona])
  registrado_por Usuario?                @relation("PagoRecibidoRegistro", fields: [id_usuario_registro], references: [id_usuario])
  validado_por   Usuario?                @relation("PagoRecibidoValidacion", fields: [id_usuario_validacion], references: [id_usuario])
  historial      PagoRecibidoHistorial[]

  @@index([id_colegio, estado])
  @@index([referencia_escrita])
  @@index([numero_operacion])
  @@index([id_cronograma])
  @@index([id_matricula])
  @@index([id_estudiante])
  @@index([id_apoderado])
}

model PagoRecibidoHistorial {
  id_historial     Int      @id @default(autoincrement())
  id_pago_recibido Int
  accion           String   @db.VarChar(40)
  estado_anterior  String?  @db.VarChar(20)
  estado_nuevo     String?  @db.VarChar(20)
  observacion      String?  @db.VarChar(700)
  metadata_json    Json?
  id_usuario       Int?
  origen           String   @default("Interno") @db.VarChar(50)
  created_at       DateTime @default(now())

  pago_recibido PagoRecibido @relation(fields: [id_pago_recibido], references: [id_pago_recibido], onDelete: Cascade)
  usuario       Usuario?     @relation("PagoRecibidoHistorialUsuario", fields: [id_usuario], references: [id_usuario], onDelete: SetNull)

  @@index([id_pago_recibido, created_at])
  @@index([id_usuario])
  @@index([accion])
}

// ======================================================
// COBRANZA
// ======================================================

model CobranzaGestion {
  id_gestion       Int       @id @default(autoincrement())
  id_cronograma    Int
  id_usuario       Int?
  canal            String    @default("WhatsApp") @db.VarChar(30)
  estado_contacto  String    @default("Mensaje enviado") @db.VarChar(40)
  telefono         String?   @db.VarChar(30)
  mensaje          String?   @db.Text
  observacion      String?   @db.VarChar(600)
  fecha_programada DateTime?
  fecha_gestion    DateTime  @default(now())
  created_at       DateTime  @default(now())

  cronograma CronogramaPagos @relation(fields: [id_cronograma], references: [id_cronograma])
  usuario    Usuario?        @relation("CobranzaGestionUsuario", fields: [id_usuario], references: [id_usuario])

  @@index([id_cronograma, fecha_gestion])
  @@index([id_usuario])
  @@index([estado_contacto])
  @@index([fecha_programada])
}

// ======================================================
// COMUNICACIÓN
// ======================================================

model Circular {
  id_circular           Int      @id @default(autoincrement())
  id_tenant             Int?
  id_colegio            Int?
  titulo                String   @db.VarChar(150)
  contenido             String   @db.Text
  fecha_creacion        DateTime @default(now())
  remitente_id_usuario  Int
  categoria             String?  @db.VarChar(50)
  urgente               Boolean  @default(false)
  requiere_autorizacion Boolean  @default(false)

  tenant    Tenant?  @relation(fields: [id_tenant], references: [id_tenant])
  colegio   Colegio? @relation(fields: [id_colegio], references: [id_colegio])
  remitente Usuario  @relation(fields: [remitente_id_usuario], references: [id_usuario])

  destinatarios CircularDestinatario[]
  adjuntos      Adjunto[]

  @@index([id_tenant])
  @@index([id_colegio])
  @@index([remitente_id_usuario])
}

model CircularDestinatario {
  id                 Int       @id @default(autoincrement())
  id_circular        Int
  id_nivel           Int?
  id_seccion         Int?
  leida              Boolean   @default(false)
  fecha_lectura      DateTime?
  confirmada         Boolean   @default(false)
  fecha_confirmacion DateTime?

  circular Circular @relation(fields: [id_circular], references: [id_circular])
  nivel    Nivel?   @relation(fields: [id_nivel], references: [id_nivel])
  seccion  Seccion? @relation(fields: [id_seccion], references: [id_seccion])

  @@index([id_circular])
  @@index([id_nivel])
  @@index([id_seccion])
}

model Adjunto {
  id_adjunto     Int    @id @default(autoincrement())
  id_circular    Int
  nombre_archivo String
  url            String

  circular Circular @relation(fields: [id_circular], references: [id_circular])

  @@index([id_circular])
}

model Notificacion {
  id_notif       Int      @id @default(autoincrement())
  id_usuario     Int
  tipo           String   @db.VarChar(50)
  titulo         String
  mensaje        String
  leida          Boolean  @default(false)
  fecha_creacion DateTime @default(now())
  url            String?

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_usuario])
  @@index([fecha_creacion])
}

// ======================================================
// HORARIOS, STAFF Y CITAS
// ======================================================

model Horario {
  id_horario  Int    @id @default(autoincrement())
  id_seccion  Int
  id_curso    Int
  id_docente  Int
  id_anio     Int?
  dia_semana  Int
  hora_inicio String @db.VarChar(5)
  hora_fin    String @db.VarChar(5)

  seccion Seccion @relation(fields: [id_seccion], references: [id_seccion])
  curso   Curso   @relation(fields: [id_curso], references: [id_curso])
  docente Docente @relation(fields: [id_docente], references: [id_persona])

  anio AnioLectivo? @relation(fields: [id_anio], references: [id_anio], onDelete: Restrict)

  @@index([id_seccion])
  @@index([id_curso])
  @@index([id_docente])
  @@index([id_anio])
}

model Staff {
  id_staff      Int     @id @default(autoincrement())
  id_tenant     Int?
  id_colegio    Int?
  id_persona    Int     @unique
  cargo         String  @db.VarChar(100)
  area          String  @db.VarChar(50)
  id_seccion    Int?
  es_tutor      Boolean @default(false)
  permite_citas Boolean @default(true)

  tenant  Tenant?  @relation(fields: [id_tenant], references: [id_tenant])
  colegio Colegio? @relation(fields: [id_colegio], references: [id_colegio])
  persona Persona  @relation(fields: [id_persona], references: [id_persona])
  seccion Seccion? @relation(fields: [id_seccion], references: [id_seccion])

  citas Cita[]

  @@index([id_tenant])
  @@index([id_colegio])
  @@index([id_seccion])
}

model Cita {
  id_cita      Int      @id @default(autoincrement())
  id_staff     Int
  id_apoderado Int
  fecha        DateTime @db.Date
  hora_inicio  String   @db.VarChar(5)
  hora_fin     String   @db.VarChar(5)
  motivo       String?  @db.Text
  estado       String   @default("pendiente") @db.VarChar(30)
  creado_en    DateTime @default(now())

  staff     Staff     @relation(fields: [id_staff], references: [id_staff])
